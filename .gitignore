# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/

# media files
*.png
*.jpg
*.jpeg
temporary_for_reference_only/
tmp/
coverage
# Obsidian per-user layout
docs/.obsidian/workspace*.json

# Built cmd binaries (go build in cmd/<name> produces cmd/<name>/<name>)
/cmd/audio/audio
/cmd/calibrate/calibrate
/cmd/cr30/cr30
/cmd/display/display
/cmd/elrs-rx/elrs-rx
/cmd/manipulator/manipulator
/cmd/monitor/monitor
/cmd/spectrometer/spectrometer
/build/
# nnbench and qi8bench firmware images built from the repo root (their READMEs)
/nnbench-*.bin
/qi8bench-*.bin
# Python bytecode from the testdata generators
__pycache__/
# Local evidence reports are not part of the repo
/docs/evidence/
